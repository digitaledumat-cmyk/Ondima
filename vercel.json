{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.ondima.ma" }],
      "destination": "https://ondima.ma/pro",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.ondima.ma" }],
      "destination": "https://ondima.ma/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/pro",
      "statusCode": 301
    }
  ]
}
